<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Staff Home</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('../partials/admin-header', { active: null }) %>

  <main class="admin-page">
    <h1>Staff Home</h1>

    <div class="admin-hub-grid">
      <a class="admin-hub-card" href="/admin/intake">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2Z"></path>
          <circle cx="12" cy="13" r="4"></circle>
        </svg>
        <h2>Intake</h2>
        <p>Photograph new items and let AI draft the listing.</p>
      </a>

      <a class="admin-hub-card" href="/staff/fulfillment">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m7.5 4.27 9 5.15"></path>
          <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
          <path d="m3.3 7 8.7 5 8.7-5"></path>
          <path d="M12 22V12"></path>
        </svg>
        <h2>Fulfillment</h2>
        <p>Pull paid orders and hand them off at pickup.</p>
      </a>
    </div>
  </main>
</body>
</html>
