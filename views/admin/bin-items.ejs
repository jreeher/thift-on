<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bin #<%= binNumber %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('../partials/admin-header', { active: 'bins' }) %>

  <main class="admin-page">
    <a class="back-link" href="/admin/bins">&larr; Back to Bins</a>
    <h1>Bin #<%= binNumber %></h1>

    <% if (items.length === 0) { %>
      <p class="empty-state">This bin is empty.</p>
    <% } else { %>
      <% items.forEach((item) => { %>
        <%- include('../partials/item-readonly-card', { item, canRemove: false, statusLabels }) %>
      <% }) %>
    <% } %>
  </main>
</body>
</html>
