<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bins</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('../partials/admin-header', { active: 'bins' }) %>

  <main class="admin-page">
    <h1>Bins</h1>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <% const suggestedCount = bins.filter((b) => b.consolidationSuggested).length; %>
    <% if (suggestedCount > 0) { %>
      <p class="consolidation-banner">
        <%= suggestedCount %> bin<%= suggestedCount === 1 ? '' : 's' %> below 25% of its peak fill level
        &mdash; consider consolidating into fewer bins.
      </p>
    <% } %>

    <div class="bins-table-wrap">
      <table class="bins-table">
        <thead>
          <tr>
            <th>Bin #</th>
            <th>Status</th>
            <th>Current Items</th>
            <th>Peak Items</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% bins.forEach((bin) => { %>
            <tr>
              <td><a class="bin-number-link" href="/admin/bins/<%= bin.bin_number %>/items"><%= bin.bin_number %></a></td>
              <td>
                <%= bin.status === 'retired' ? 'Empty' : bin.status %>
                <% if (bin.consolidationSuggested) { %>
                  <span class="suggestion-badge">low occupancy</span>
                <% } %>
              </td>
              <td><%= bin.occupied_count %></td>
              <td><%= bin.peak_item_count %></td>
              <td class="bin-actions">
                <% if (bin.status === 'active' && bin.consolidationSuggested) { %>
                  <form method="POST" action="/admin/bins/<%= bin.id %>/flag-consolidation">
                    <button type="submit">Flag for Consolidation</button>
                  </form>
                <% } %>
                <% if (bin.status === 'needs_consolidation') { %>
                  <form method="POST" action="/admin/bins/<%= bin.id %>/resolve-consolidation">
                    <button type="submit">Mark Consolidated</button>
                  </form>
                <% } %>
                <% if (bin.status !== 'retired') { %>
                  <form method="POST" action="/admin/bins/<%= bin.id %>/retire">
                    <button type="submit">Empty</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
