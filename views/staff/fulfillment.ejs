<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fulfillment Queue</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('../partials/admin-header', { active: 'fulfillment' }) %>

  <main class="staff-page">
    <h1>Fulfillment</h1>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <% if (orders.length === 0) { %>
      <p class="empty-state">No orders waiting on fulfillment.</p>
    <% } %>

    <% orders.forEach((order) => { %>
      <section class="order-card">
        <div class="order-card-header">
          <strong class="order-number"><%= order.orderNumber %></strong>
          <span class="order-customer">
            <%= order.customerName || order.customerEmail %><% if (order.customerPhone) { %> &middot; <%= order.customerPhone %><% } %>
            <% if (order.pickupDate) { %>
              &middot; pickup <%= new Date(order.pickupDate).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric' }) %><% if (order.pickupTimeLabel) { %> <%= order.pickupTimeLabel %><% } %>
            <% } %>
          </span>
        </div>

        <% order.items.forEach((item) => { %>
          <div class="fulfillment-item">
            <div class="fulfillment-item-photo">
              <% if (item.photoUrl) { %>
                <img src="<%= item.photoUrl %>" alt="<%= item.title %>">
              <% } else { %>
                <div class="no-photo">No photo</div>
              <% } %>
            </div>
            <div class="fulfillment-item-info">
              <p class="fulfillment-item-title"><%= item.title %></p>
              <p class="fulfillment-item-bin">Bin #<%= item.binNumber %></p>
            </div>
            <% if (item.status === 'sold_pending_pull') { %>
              <form method="POST" action="/staff/items/<%= item.id %>/pulled">
                <button type="submit" class="pull-btn">Mark Pulled</button>
              </form>
            <% } else { %>
              <span class="pulled-badge">Pulled &#10003;</span>
              <form method="POST" action="/staff/items/<%= item.id %>/decline" class="decline-form">
                <button type="submit" class="decline-btn">Declined</button>
              </form>
            <% } %>
          </div>
        <% }) %>

        <% if (order.orderStatus === 'ready_for_pickup') { %>
          <form method="POST" action="/staff/orders/<%= order.orderId %>/picked-up">
            <button type="submit" class="pickup-btn">Mark Picked Up</button>
          </form>
        <% } %>
      </section>
    <% }) %>
  </main>
</body>
</html>
