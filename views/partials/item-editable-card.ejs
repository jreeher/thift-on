<section class="review-card">
  <div class="review-card-photo">
    <% if (item.photo_url) { %>
      <img src="<%= item.photo_url %>" alt="Item photo">
    <% } else { %>
      <div class="no-photo">No photo</div>
    <% } %>
  </div>
  <div class="review-card-form">
    <form method="POST" action="/admin/inventory/<%= item.id %>/edit">
      <input type="hidden" name="status" value="<%= item.status %>">
      <label>
        Title
        <input type="text" name="title" maxlength="60" value="<%= item.title || '' %>">
      </label>
      <label>
        Category
        <select name="category">
          <% categories.forEach((c) => { %>
            <option value="<%= c %>" <%= item.category === c ? 'selected' : '' %>><%= c %></option>
          <% }) %>
        </select>
      </label>
      <label>
        Description
        <textarea name="description" rows="3"><%= item.description || '' %></textarea>
      </label>
      <label>
        Condition notes
        <textarea name="condition_notes" rows="2"><%= item.condition_notes || '' %></textarea>
      </label>
      <label>
        Bin number
        <input type="number" name="bin_number" min="1" value="<%= item.bin_number || '' %>">
      </label>
      <button type="submit">Save Changes</button>
    </form>
    <form method="POST" action="/admin/inventory/<%= item.id %>/remove">
      <input type="hidden" name="status" value="<%= item.status %>">
      <button type="submit" class="secondary-btn">Remove</button>
    </form>
  </div>
</section>
