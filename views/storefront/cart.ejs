<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Cart</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('../partials/storefront-header') %>

  <main class="cart-page">
    <h1>Your Cart</h1>

    <% if (items.length === 0) { %>
      <p class="empty-state">Your cart is empty. <a href="/">Browse items</a>.</p>
    <% } else { %>
      <% items.forEach((item) => { %>
        <div class="cart-item">
          <div class="cart-item-photo">
            <% if (item.photo_url) { %>
              <img src="<%= item.photo_url %>" alt="<%= item.title %>">
            <% } else { %>
              <div class="no-photo">No photo</div>
            <% } %>
          </div>
          <div class="cart-item-info">
            <p class="cart-item-title"><%= item.title %></p>
            <p class="cart-item-price"><%- include('../partials/item-price', { item }) %></p>
            <p class="cart-item-countdown" data-reserved-until="<%= item.reserved_until.toISOString() %>">
              Reserved &mdash; expires in <span class="countdown-value">--:--</span>
            </p>
          </div>
          <div class="cart-item-remove">
            <form method="POST" action="/cart/remove/<%= item.id %>">
              <button type="submit">Remove</button>
            </form>
          </div>
        </div>
      <% }) %>

      <div class="cart-summary">
        <span class="cart-subtotal">Subtotal: $<%= (subtotalCents / 100).toFixed(2) %></span>
      </div>

      <% if (!phone) { %>
        <form method="GET" action="/cart" class="bin-create-form">
          <label>
            Phone number
            <input type="tel" name="phone" value="" placeholder="(555) 555-5555">
          </label>
          <button type="submit" class="secondary-btn">Check for store credit</button>
        </form>
        <p class="admin-hint">
          Checking here tells you your store credit balance ahead of time — or just enter
          your phone in the form below, it's needed either way for pickup confirmation.
        </p>
      <% } else { %>
        <% if (creditLookupRateLimited) { %>
          <p class="admin-hint">Too many attempts — please wait a moment and try again.</p>
        <% } else if (!(donorBalanceCents > 0)) { %>
          <p class="admin-hint">No store credit available for that number.</p>
        <% } else { %>
          <p class="success-banner">You have $<%= (donorBalanceCents / 100).toFixed(2) %> in store credit available.</p>
        <% } %>
      <% } %>

      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>

      <form method="POST" action="/checkout" class="checkout-form">
        <% if (phone) { %>
          <input type="hidden" name="phone" value="<%= phone %>">
        <% } else { %>
          <label>
            Phone number (for pickup confirmation)
            <input type="tel" name="phone" required placeholder="(555) 555-5555">
          </label>
        <% } %>
        <% if (donorBalanceCents > 0) { %>
          <label class="checkbox-label">
            <input type="checkbox" name="apply_credit" value="yes">
            Apply my $<%= (donorBalanceCents / 100).toFixed(2) %> store credit to this order?
          </label>
        <% } %>
        <label>
          First name
          <input type="text" name="first_name" required maxlength="60" placeholder="Jane">
        </label>
        <label>
          Pickup time
          <select name="pickup_slot" required>
            <option value="" disabled selected>Choose a pickup time</option>
            <% availablePickupSlots.forEach((slot) => { %>
              <option value="<%= slot.value %>"><%= slot.label %></option>
            <% }) %>
          </select>
        </label>
        <p class="admin-hint">
          Your card is authorized now but not charged until you pick up your order — you
          won't be charged for anything you decide not to take.
        </p>
        <button type="submit" class="checkout-btn">Checkout</button>
      </form>
    <% } %>
  </main>

  <%- include('../partials/storefront-footer') %>

  <script>
    function formatRemaining(ms) {
      if (ms <= 0) return 'expired';
      const totalSeconds = Math.floor(ms / 1000);
      const minutes = Math.floor(totalSeconds / 60);
      const seconds = totalSeconds % 60;
      return minutes + ':' + String(seconds).padStart(2, '0');
    }

    function tick() {
      document.querySelectorAll('.cart-item-countdown').forEach((el) => {
        const reservedUntil = new Date(el.dataset.reservedUntil).getTime();
        const remaining = reservedUntil - Date.now();
        const valueEl = el.querySelector('.countdown-value');
        valueEl.textContent = formatRemaining(remaining);
      });
    }

    tick();
    setInterval(tick, 1000);
  </script>
</body>
</html>
