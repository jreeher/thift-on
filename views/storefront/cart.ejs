<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Cart</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('../partials/storefront-header') %>

  <main class="cart-page">
    <h1>Your Cart</h1>

    <% if (items.length === 0) { %>
      <p class="empty-state">Your cart is empty. <a href="/">Browse items</a>.</p>
    <% } else { %>
      <% items.forEach((item) => { %>
        <div class="cart-item">
          <div class="cart-item-photo">
            <% if (item.photo_url) { %>
              <img src="<%= item.photo_url %>" alt="<%= item.title %>">
            <% } else { %>
              <div class="no-photo">No photo</div>
            <% } %>
          </div>
          <div class="cart-item-info">
            <p class="cart-item-title"><%= item.title %></p>
            <p class="cart-item-price">$<%= (item.price_current_cents / 100).toFixed(2) %></p>
            <p class="cart-item-countdown" data-reserved-until="<%= item.reserved_until.toISOString() %>">
              Reserved &mdash; expires in <span class="countdown-value">--:--</span>
            </p>
          </div>
          <div class="cart-item-remove">
            <form method="POST" action="/cart/remove/<%= item.id %>">
              <button type="submit">Remove</button>
            </form>
          </div>
        </div>
      <% }) %>

      <div class="cart-summary">
        <span class="cart-subtotal">Subtotal: $<%= (subtotalCents / 100).toFixed(2) %></span>
      </div>

      <form method="GET" action="/cart" class="bin-create-form">
        <label>
          Have store credit? Enter phone number
          <input type="tel" name="donor_phone" value="<%= donorPhone || '' %>" placeholder="(555) 555-5555">
        </label>
        <button type="submit" class="secondary-btn">Check</button>
      </form>

      <% if (donorPhone && donorBalanceCents === null) { %>
        <p class="admin-hint">No store credit found for that number.</p>
      <% } else if (donorBalanceCents > 0) { %>
        <p class="success-banner">You have $<%= (donorBalanceCents / 100).toFixed(2) %> in store credit available.</p>
      <% } %>

      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>

      <form method="POST" action="/checkout" class="checkout-form">
        <% if (donorBalanceCents > 0) { %>
          <input type="hidden" name="donor_phone" value="<%= donorPhone %>">
          <label>
            Apply credit ($)
            <input
              type="number"
              name="credit_dollars"
              min="0"
              step="0.01"
              max="<%= (Math.min(donorBalanceCents, subtotalCents) / 100).toFixed(2) %>"
              value="<%= (Math.min(donorBalanceCents, subtotalCents) / 100).toFixed(2) %>"
            >
          </label>
        <% } %>
        <label>
          Email (for your receipt and pickup confirmation)
          <input type="email" name="email" required placeholder="you@example.com">
        </label>
        <button type="submit" class="checkout-btn">Checkout</button>
      </form>
    <% } %>
  </main>

  <%- include('../partials/storefront-footer') %>

  <script>
    function formatRemaining(ms) {
      if (ms <= 0) return 'expired';
      const totalSeconds = Math.floor(ms / 1000);
      const minutes = Math.floor(totalSeconds / 60);
      const seconds = totalSeconds % 60;
      return minutes + ':' + String(seconds).padStart(2, '0');
    }

    function tick() {
      document.querySelectorAll('.cart-item-countdown').forEach((el) => {
        const reservedUntil = new Date(el.dataset.reservedUntil).getTime();
        const remaining = reservedUntil - Date.now();
        const valueEl = el.querySelector('.countdown-value');
        valueEl.textContent = formatRemaining(remaining);
      });
    }

    tick();
    setInterval(tick, 1000);
  </script>
</body>
</html>
